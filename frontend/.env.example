# FieldShift FarmOS - Frontend Environment Variables

# Backend API URL
NEXT_PUBLIC_API_BASE=http://localhost:8000/api

# Optional: Analytics or monitoring keys (not required for basic functionality)
# NEXT_PUBLIC_ANALYTICS_ID=

# Optional: Map tile server (defaults to OpenStreetMap)
# NEXT_PUBLIC_MAP_TILES=https://tile.openstreetmap.org/
